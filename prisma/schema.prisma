// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}



enum Role {
  ADMIN
  TECNICO
  SOLICITANTE
}

enum Status {
  ABERTO
  EM_ANDAMENTO
  AGUARDANDO
  CONCLUIDO
  CANCELADO
}

enum Prioridade {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

model User {
  id        Int      @id @default(autoincrement())
  nome      String
  email     String   @unique
  senha     String
  cpf       String?  @unique
  role      Role     @default(SOLICITANTE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chamadosSolicitados Ticket[] @relation("Solicitante")
  chamadosAtribuidos  Ticket[] @relation("Tecnico")
  historicos          Historico[]
}

model Ticket {
  id          Int        @id @default(autoincrement())
  titulo      String
  descricao   String
  status      Status     @default(ABERTO)
  prioridade  Prioridade @default(MEDIA)

  solicitanteId Int
  tecnicoId     Int?

  prazoSLA    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  concluidoAt DateTime?

  solicitante User  @relation("Solicitante", fields: [solicitanteId], references: [id], onDelete: Restrict)
  tecnico     User? @relation("Tecnico", fields: [tecnicoId], references: [id], onDelete: SetNull)

  historicos Historico[]

  @@index([solicitanteId])
  @@index([tecnicoId])
  @@index([status])
  @@index([prioridade])
}

model Historico {
  id        Int      @id @default(autoincrement())
  acao      String
  detalhes  String?
  createdAt DateTime @default(now())

  ticketId Int
  usuarioId Int

  ticket  Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  usuario User   @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([ticketId])
}

